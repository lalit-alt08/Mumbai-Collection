<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^assets/ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <Files "index.html">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$" storefront_fingerprinted
    Header set Cache-Control "public, max-age=31536000, immutable" env=storefront_fingerprinted
  </IfModule>
</IfModule>
