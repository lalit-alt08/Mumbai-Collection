# Production Environment Example for Customer Web (Storefront)
# Set your production Node backend API URL:
VITE_API_URL=https://api.yourdomain.com/api

# Set your production WordPress domain:
VITE_WORDPRESS_URL=https://yourdomain.com

# Set your production Google OAuth Client ID:
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Set your production WhatsApp Business contact number (digits only, e.g. 917339951567):
VITE_WHATSAPP_PHONE=917339951567
