# Server Configuration
PORT=5000
# Optional bind address; the server defaults to 0.0.0.0.
# Uncomment/set only when your hosting environment requires a specific interface.
# HOST=0.0.0.0
# Origin idle keep-alive timeout (ms); default 95000 to outlast Cloudflare Tunnel's default 90000ms.
HTTP_KEEP_ALIVE_TIMEOUT_MS=95000
NODE_ENV=development
LOG_LEVEL=info

# Performance & Networking
# Max concurrent HTTP agent sockets dedicated to streaming media from WordPress (default: 30)
MEDIA_MAX_SOCKETS=30

# Distributed Redis Cache (Optional in dev, Recommended for multi-instance production)
# If omitted or empty, backend gracefully operates with local high-performance in-memory cache driver
# e.g. redis://default:password@127.0.0.1:6379 or redis://localhost:6379
# REDIS_URL=redis://127.0.0.1:6379
# Alternative connection fields if REDIS_URL is not used:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Testing & Development Flags
# Set to "true" only during automated testing or local benchmarking to bypass in-memory rate limits
DISABLE_RATE_LIMIT=false
# Set true only when requests reach this server through a trusted Cloudflare proxy
# that sets CF-Connecting-IP. Cloudflare's CF-Ray header is also recognized automatically.
TRUST_CLOUDFLARE_PROXY=false

# WooCommerce / WordPress Core API
WOOCOMMERCE_URL=http://localhost/mumbaicollection
WOOCOMMERCE_API_TIMEOUT_MS=15000
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WORDPRESS_URL=http://localhost/mumbaicollection
WP_USERNAME=admin
WP_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx

# Internal Security (Shared secret between Node.js and WordPress custom plugin mumbai-auth.php)
# Must match MUMBAI_INTERNAL_API_KEY defined in WordPress wp-config.php
MUMBAI_INTERNAL_API_KEY=your_mumbai_internal_secret_key
# Dedicated secret used by Node.js to HMAC-SHA256 hash customer OTPs before storing in database
# Generate a strong 64-character random hex string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HMAC_SECRET=<strong-random-secret>

# Panel Origins (CORS & CSRF Whitelist)
CUSTOMER_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
EMPLOYEE_ORIGIN=http://localhost:5175
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Additional production or preview origins, comma-separated (replace with your deployed domains)
ALLOWED_ORIGINS=https://your-store.vercel.app,https://your-admin.vercel.app,https://your-employee.vercel.app
# Keep false in production unless a production admin tool is intentionally hosted on localhost.
ALLOW_LOCAL_ORIGINS=false
# Enable wildcard allowances (*.vercel.app, *.trycloudflare.com) in production (defaults to true in dev/test, false in production)
ALLOW_PREVIEW_ORIGINS=false

# Google SSO
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Brevo Transactional Email (OTP Delivery)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_EMAIL_SENDER_NAME="Mumbai Collection"
# In local development, you can use your Brevo account-verified email in your local .env
# In production, use your domain sender (e.g. noreply@mumbaicollection.in) once DNS SPF/DKIM is configured
BREVO_EMAIL_SENDER_EMAIL=noreply@mumbaicollection.in
MOCK_EMAIL=false

# Razorpay Payment Gateway (Backend Only — NEVER expose KEY_SECRET or WEBHOOK_SECRET to frontend)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Keep false in production. Enable only for a deliberately configured payment staging environment.
ALLOW_TEST_PAYMENTS=false
# Webhook secret configured in Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Optional operational alerts (configure Discord or both Telegram values in production)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id
# Private persistent directory, shared by all PM2 workers on the VPS. Never serve it publicly.
# ALERT_SPOOL_DIR=/srv/private/mumbai-alerts
# Independent monitor: generate a random secret; do not use a VITE_ prefix.
# OPS_HEALTH_TOKEN=your_random_monitor_secret
# MONITOR_HEALTH_URL=https://your-api.example/api/ops/health
# MONITOR_ENV_FILE=/srv/private/monitor.env
# MONITOR_INSTANCE_ID=mumbai-vps
# MONITOR_DISK_PATH=/
# BACKUP_ROOT=/srv/private-backups
# Epoch-seconds marker written ONLY after a successful verified off-server upload.
# OFFSITE_BACKUP_MARKER=/srv/private/offsite-backup-last-success
# MONITOR_MAX_BACKUP_AGE_HOURS=26

