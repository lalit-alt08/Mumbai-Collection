# Copy this file to .env.docker for local Docker Compose development:
#   cp .env.docker.example .env.docker
# Then run:
#   docker compose --env-file .env.docker up -d --build
#
# NEVER commit .env.docker or real production credentials!

# Ports exposed on loopback only
BACKEND_PORT=127.0.0.1:5000
WP_PORT=127.0.0.1:8085
NODE_ENV=development
ALLOW_LOCAL_ORIGINS=true
TRUST_CLOUDFLARE_PROXY=false

# MySQL (local Docker dev only)
MYSQL_DATABASE=mumbai_wp
MYSQL_USER=mumbai
MYSQL_PASSWORD=mumbai_dev_pass
MYSQL_ROOT_PASSWORD=mumbai_root_dev_pass

# WordPress initial admin account (created automatically on first boot)
WP_SITE_URL=http://localhost:8085
WP_SITE_TITLE="Mumbai Collection Local"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@example.com

# Web Push VAPID keys (mandatory when NODE_ENV=production)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operations@mumbaicollection.in

# Shared internal secrets (safe placeholders for local dev; replace with random hex if needed)
MUMBAI_INTERNAL_API_KEY=dev_internal_secret_change_me
OTP_HMAC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Local dev WooCommerce REST API credentials (auto-seeded by wordpress-init)
WOOCOMMERCE_CONSUMER_KEY=ck_dev_mumbai_local_key_000000000000000000
WOOCOMMERCE_CONSUMER_SECRET=cs_dev_mumbai_local_secret_000000000000000

# Frontend dev origins
CUSTOMER_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
EMPLOYEE_ORIGIN=http://localhost:5175

# Email OTP: true logs OTP codes to backend container logs without needing Brevo
MOCK_EMAIL=true
BREVO_API_KEY=
BREVO_EMAIL_SENDER_NAME="Mumbai Collection"
BREVO_EMAIL_SENDER_EMAIL=noreply@mumbaicollection.in

# Optional third-party test credentials (leave blank if not testing Google SSO / Razorpay)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_TEST_PAYMENTS=true
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
